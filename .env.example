ANTHROPIC_API_KEY=
# Langfuse Cloud (EU region). Only masked payloads are ever sent.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Models (override here; prices live in src/hri/config/prices.yaml)
EXTRACT_MODEL=claude-haiku-5-5
BRIEF_MODEL=claude-sonnet-5-5
VERIFY_MODEL=claude-haiku-5-5

# Failure-demo switch: set to 1 to simulate the LLM provider being down
LLM_KILL_SWITCH=0
